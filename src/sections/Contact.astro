---
import { personal } from "../lib/data";
import { getLangFromUrl, t } from "../lib/i18n";
import SectionHeading from "../components/SectionHeading.astro";
import Reveal from "../components/Reveal";
import LinkedinIcon from "../components/LinkedinIcon";
import { Mail, Phone, MessageCircle, MapPin } from "lucide-react";

const lang = getLangFromUrl(Astro.url);
const waMsg = encodeURIComponent(
  lang === "es"
    ? "Hola Daniel, vi tu portfolio y quería consultarte un proyecto."
    : "Hi Daniel, I saw your portfolio and want to discuss a project.",
);
---

<section id="contact" class="relative scroll-mt-20 py-16 sm:py-24 md:py-32">
  <div class="mx-auto max-w-5xl px-3 sm:px-6">
    <SectionHeading
      eyebrow={t(lang, "contact.eyebrow")}
      title={t(lang, "contact.title")}
      subtitle={t(lang, "contact.sub")}
    />

    <Reveal client:load>
      <div
        class="relative overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-surface/80 to-bg-elevated/60 p-4 backdrop-blur-xl sm:rounded-3xl sm:p-6 md:p-10"
      >
        <div aria-hidden class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-gradient-to-br from-[#ABD2FA]/20 to-[#1B2CC1]/0 blur-3xl"></div>
        <div aria-hidden class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-gradient-to-tr from-[#1B2CC1]/25 to-[#7692FF]/0 blur-3xl"></div>

        <div class="relative grid gap-5 lg:grid-cols-[1fr_1.1fr] lg:gap-8">
          <!-- Contact channels -->
          <div class="space-y-2.5 sm:space-y-3">
            <a
              href={`https://wa.me/${personal.whatsapp}?text=${waMsg}`}
              target="_blank"
              rel="noopener"
              class="group flex min-h-[64px] items-center gap-3 rounded-2xl border border-border bg-surface/60 p-3 transition hover:-translate-y-0.5 hover:border-emerald-400/50 hover:bg-emerald-400/5 sm:gap-4 sm:p-4"
            >
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-emerald-500/15 text-emerald-400 sm:h-12 sm:w-12">
                <MessageCircle size={20} className="sm:!w-[22px] sm:!h-[22px]" />
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] uppercase tracking-widest text-text-dim sm:text-xs">
                  {t(lang, "contact.wa")}
                </p>
                <p class="truncate text-sm font-semibold text-text sm:text-base">{personal.phone}</p>
              </div>
              <span class="shrink-0 text-text-dim transition group-hover:translate-x-1 group-hover:text-emerald-400">→</span>
            </a>

            <a
              href={`mailto:${personal.email}`}
              class="group flex min-h-[64px] items-center gap-3 rounded-2xl border border-border bg-surface/60 p-3 transition hover:-translate-y-0.5 hover:border-accent/50 hover:bg-accent/5 sm:gap-4 sm:p-4"
            >
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-accent/15 text-accent-glow sm:h-12 sm:w-12">
                <Mail size={20} className="sm:!w-[22px] sm:!h-[22px]" />
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] uppercase tracking-widest text-text-dim sm:text-xs">
                  {t(lang, "contact.email")}
                </p>
                <p class="truncate text-sm font-semibold text-text sm:text-base">{personal.email}</p>
              </div>
              <span class="shrink-0 text-text-dim transition group-hover:translate-x-1 group-hover:text-accent-glow">→</span>
            </a>

            <a
              href={personal.linkedin}
              target="_blank"
              rel="noopener"
              class="group flex min-h-[64px] items-center gap-3 rounded-2xl border border-border bg-surface/60 p-3 transition hover:-translate-y-0.5 hover:border-[#7692FF]/50 hover:bg-[#7692FF]/5 sm:gap-4 sm:p-4"
            >
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[#7692FF]/15 text-[#ABD2FA] sm:h-12 sm:w-12">
                <LinkedinIcon size={20} className="sm:!w-[22px] sm:!h-[22px]" />
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] uppercase tracking-widest text-text-dim sm:text-xs">
                  {t(lang, "contact.linkedin")}
                </p>
                <p class="truncate text-sm font-semibold text-text sm:text-base">{personal.linkedinHandle}</p>
              </div>
              <span class="shrink-0 text-text-dim transition group-hover:translate-x-1 group-hover:text-[#ABD2FA]">→</span>
            </a>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 px-1 pt-2 text-[11px] text-text-dim sm:text-xs">
              <span class="inline-flex items-center gap-1.5">
                <MapPin size={14} />
                {personal.location}
              </span>
              <span class="inline-flex items-center gap-1.5">
                <Phone size={14} />
                {personal.phone}
              </span>
            </div>
          </div>

          <!-- Form -->
          <form
            class="space-y-3 rounded-2xl border border-border-subtle bg-bg-elevated/60 p-3.5 sm:p-5"
            action={`mailto:${personal.email}`}
            method="post"
            enctype="text/plain"
          >
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="block">
                <span class="mb-1.5 block text-[10px] uppercase tracking-widest text-text-dim sm:text-xs">
                  {t(lang, "contact.form.name")}
                </span>
                <input
                  type="text"
                  name="name"
                  required
                  autocomplete="name"
                  class="min-h-[44px] w-full rounded-xl border border-border bg-bg/60 px-3 py-2.5 text-sm text-text outline-none transition focus:border-accent focus:bg-bg focus:shadow-[0_0_0_3px_rgba(118,146,255,0.22)]"
                />
              </label>
              <label class="block">
                <span class="mb-1.5 block text-[10px] uppercase tracking-widest text-text-dim sm:text-xs">
                  {t(lang, "contact.form.company")}
                </span>
                <input
                  type="text"
                  name="company"
                  autocomplete="organization"
                  class="min-h-[44px] w-full rounded-xl border border-border bg-bg/60 px-3 py-2.5 text-sm text-text outline-none transition focus:border-accent focus:bg-bg focus:shadow-[0_0_0_3px_rgba(118,146,255,0.22)]"
                />
              </label>
            </div>

            <label class="block">
              <span class="mb-1.5 block text-[10px] uppercase tracking-widest text-text-dim sm:text-xs">
                {t(lang, "contact.form.email")}
              </span>
              <input
                type="email"
                name="email"
                required
                inputmode="email"
                autocomplete="email"
                class="min-h-[44px] w-full rounded-xl border border-border bg-bg/60 px-3 py-2.5 text-sm text-text outline-none transition focus:border-accent focus:bg-bg focus:shadow-[0_0_0_3px_rgba(118,146,255,0.22)]"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-[10px] uppercase tracking-widest text-text-dim sm:text-xs">
                {t(lang, "contact.form.message")}
              </span>
              <textarea
                name="message"
                rows="4"
                required
                class="w-full resize-y rounded-xl border border-border bg-bg/60 px-3 py-2.5 text-sm text-text outline-none transition focus:border-accent focus:bg-bg focus:shadow-[0_0_0_3px_rgba(118,146,255,0.22)] min-h-[120px]"
              ></textarea>
            </label>

            <button
              type="submit"
              class="group relative min-h-[48px] w-full overflow-hidden rounded-xl bg-gradient-to-r from-[#1B2CC1] via-[#ABD2FA] to-[#7692FF] px-4 py-3 text-sm font-semibold text-bg shadow-[0_8px_30px_-8px_rgba(27,44,193,0.55)] transition-shadow hover:shadow-[0_8px_40px_-6px_rgba(27,44,193,0.8)]"
            >
              <span class="relative z-10">{t(lang, "cta.send")}</span>
              <span
                aria-hidden
                class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/30 to-transparent transition-transform duration-700 group-hover:translate-x-full"
              ></span>
            </button>

            <p class="text-center text-[10px] leading-relaxed text-text-dim sm:text-[11px]">
              {t(lang, "contact.form.note")}
            </p>
          </form>
        </div>
      </div>
    </Reveal>
  </div>
</section>
